<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>後台登入｜<%= site.siteName %></title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <form class="login-box" method="post">
    <h1><%= site.siteName %></h1>
    <p>後台管理系統</p>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>帳號<input name="username" autocomplete="username" required autofocus></label>
    <label>密碼<input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn primary block">登入</button>
    <a href="/" class="muted">← 回網站</a>
  </form>
</body>
</html>
