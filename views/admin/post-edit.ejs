<%- include('_top') %>
<%
  const pubLocal = post.publishedAt ? new Date(new Date(post.publishedAt).getTime() + 8 * 3600000).toISOString().slice(0, 16) : '';
  const isNew = !post.id;
%>
<form method="post" action="<%= isNew ? '/admin/posts/new' : '/admin/posts/' + post.id %>" enctype="multipart/form-data" class="post-editor">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="post-main">
    <section class="panel">
      <input class="title-input" name="title" value="<%= post.title || '' %>" placeholder="文章標題" required>
      <div class="field">
        <label>網址代稱</label>
        <div class="slug-row"><span class="muted">/blog/</span><input name="slug" value="<%= post.slug || '' %>" placeholder="留空自動依標題產生"></div>
      </div>
      <div class="field">
        <label>內文</label>
        <div class="editor editor-tall" data-target="content"></div>
        <textarea id="content" name="content" hidden><%= post.content || '' %></textarea>
        <small class="help">工具列的圖片按鈕可直接上傳圖片插入內文；影片按鈕可貼 YouTube 網址。</small>
      </div>
      <div class="field">
        <label>摘要</label>
        <textarea name="excerpt" rows="3" placeholder="顯示在文章列表卡片，留空自動擷取內文前段"><%= post.excerpt || '' %></textarea>
      </div>
    </section>
    <section class="panel">
      <h2>SEO 設定</h2>
      <div class="field"><label>SEO 標題</label><input name="metaTitle" value="<%= post.metaTitle || '' %>" placeholder="留空使用文章標題"><small class="help">建議 30 字內</small></div>
      <div class="field"><label>SEO 描述</label><textarea name="metaDescription" rows="2" placeholder="留空使用摘要"><%= post.metaDescription || '' %></textarea><small class="help">建議 80–150 字</small></div>
    </section>
  </div>
  <aside class="post-side">
    <section class="panel">
      <h2>發布</h2>
      <div class="field">
        <label>狀態</label>
        <select name="status">
          <option value="draft" <%= post.status !== 'published' ? 'selected' : '' %>>草稿</option>
          <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>發布</option>
        </select>
      </div>
      <div class="field"><label>發布時間</label><input type="datetime-local" name="publishedAt" value="<%= pubLocal %>"><small class="help">設定未來時間即為排程發布（台灣時間）</small></div>
      <div class="field"><label>作者</label><input name="author" value="<%= post.author || '' %>"></div>
      <label class="check"><input type="checkbox" name="featured" value="1" <%= post.featured ? 'checked' : '' %>> 精選文章</label>
      <div class="side-actions">
        <button class="btn primary block">儲存</button>
        <% if (!isNew) { %><a class="btn block" href="/blog/<%= encodeURIComponent(post.slug) %>" target="_blank">預覽 ↗</a><% } %>
      </div>
    </section>
    <section class="panel">
      <h2>分類與標籤</h2>
      <div class="field">
        <label>分類</label>
        <select name="categoryId">
          <option value="">未分類</option>
          <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === post.categoryId ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
        <small class="help"><a href="/admin/categories">管理分類</a></small>
      </div>
      <div class="field"><label>標籤</label><input name="tags" value="<%= (post.tags || []).join(', ') %>" placeholder="以逗號分隔"></div>
    </section>
    <section class="panel">
      <h2>封面圖片</h2>
      <%- include('_field', { f: { name: 'cover', label: '', type: 'image', help: '建議 1200×750（16:10）' }, values: post }) %>
    </section>
  </aside>
</form>
<% if (!isNew) { %>
<form method="post" action="/admin/posts/<%= post.id %>/delete" data-confirm="確定要刪除這篇文章嗎？此動作無法復原。" class="danger-zone">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button class="btn danger">刪除文章</button>
</form>
<% } %>
<%- include('_bottom') %>
