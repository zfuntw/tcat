<%- include('head') %>
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="brand">
      <% if (site.logo) { %><img src="<%= site.logo %>" alt="<%= site.siteName %>"><% } else { %><span><%= site.siteName %></span><% } %>
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="開啟選單" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav class="site-nav" id="siteNav">
      <% (site.navItems || []).forEach(function (item) {
           const url = h.safeUrl(item.url);
           const active = url === '/' ? currentPath === '/' : currentPath.startsWith(url) && url.startsWith('/');
           const external = /^https?:/.test(url); %>
        <a href="<%= url %>" class="<%= active ? 'active' : '' %>" <%- external ? 'target="_blank" rel="noopener"' : '' %>><%= item.label %></a>
      <% }) %>
    </nav>
  </div>
</header>
<main>
